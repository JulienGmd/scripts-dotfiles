#compdef dotfiles

# TODO

_dotfiles() {
  local -a commands
  commands=(
    'help:Display this help message'
    'add:Add FILE(s) to be tracked'
    'rm:Remove FILE(s) from being tracked'
    'push:Push changes'
    'pull:Pull changes'
    'git:Run a git command on the dotfiles repository'
  )

  _arguments -C \
    '1: :->command' \
    '*:: :->args'

  case $state in
    command)
      _describe -t commands 'dotfiles.sh commands' commands
      ;;
    args)
      case $words[1] in
        add|rm)
          _files
          ;;
        git)
          _git
          ;;
      esac
      ;;
  esac
}

_dotfiles "$@"
